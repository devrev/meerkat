{
  "name": "meerkat-browser-runner",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "meerkat-browser-runner/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "options": {
        "outDir": "../dist/meerkat-browser-runner"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/meerkat-browser-runner"],
      "options": {
        "command": "npx vitest run --config meerkat-browser-runner/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["meerkat-browser-runner/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
