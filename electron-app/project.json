{
  "name": "electron-app",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "electron-app/src",
  "projectType": "application",
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/electron-app"],
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx build electron-app && electron dist/electron-app/main.js"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx build electron-app && npx nx build benchmarking-app && electron-builder --dir --config electron-app/electron-builder.config.cjs --config.directories.output=dist/packages"
      }
    },
    "make": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx build electron-app && npx nx build benchmarking-app && electron-builder --config electron-app/electron-builder.config.cjs --config.directories.output=dist/executables"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["electron-app/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "electron-app/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
